# Frontend environment. Copy to .env.local for dev; set these in the platform
# (Vercel) for prod. Only NEXT_PUBLIC_* vars reach the browser.

# Base URL of the FastAPI backend. Server-side only, never exposed to clients.
BACKEND_URL=http://127.0.0.1:8000

# Abort a backend call after this many ms. Keep above the backend's own
# REQUEST_TIMEOUT_S (30s) so its graceful timeout reply wins.
BACKEND_TIMEOUT_MS=35000

# Canonical public site URL. Used for metadata canonicals, Open Graph, sitemap,
# robots, and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
