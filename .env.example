# Copy to .env for local dev. Never commit the real .env (PLAN §9).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides — defaults live in app/config.py (ARCH §7).
# SCOPE_THRESHOLD=1.0
# RETRIEVE_K=4
# MIN_CANDIDATES=3

# Embeddings provider: openai (default, needs OPENAI_API_KEY) or ollama (local, free).
# EMBEDDINGS_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# Serving limits (PLAN §9)
# REQUEST_TIMEOUT_S=30
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_S=60
# ALLOWED_ORIGINS=https://your-frontend.example   # comma-separated; empty = same-origin

# Crisis helpline shown when the caller's locale has no usable region (bare "en"
# or an unstocked one). UK-audience default; set "" to use the international page.
# DEFAULT_CRISIS_REGION=UK
